{
  "name": "creattia-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:video-pipeline": "node --experimental-strip-types scripts/test-video-pipeline.mjs",
    "test:video-media": "node --experimental-strip-types scripts/test-video-media.mjs",
    "test:video-e2e": "node --env-file=.env.local --experimental-strip-types scripts/e2e-video-generation.mjs",
    "test:video-refund": "node --env-file=.env.local scripts/test-video-refund.mjs",
    "production:verify": "node --env-file-if-exists=.env scripts/verify-creattia-production.mjs",
    "references:import": "node --env-file-if-exists=.env scripts/import-reference-library.mjs",
    "references:import-angles": "node --env-file=.env.local scripts/import-user-angle-library.mjs",
    "references:curate": "node --env-file=.env.local scripts/curate-winner-library.mjs",
    "references:verify": "node --env-file=.env.local scripts/verify-curated-library.mjs",
    "references:manifest": "node scripts/build-reference-starter-manifest.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.3",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@google/genai": "^2.15.0",
    "@runwayml/sdk": "^4.13.1",
    "@supabase/supabase-js": "2.110.5",
    "@vercel/functions": "^3.7.5",
    "astro": "7.0.9",
    "cheerio": "1.2.0",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.12.0",
    "openai": "6.46.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.3",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "playwright": "^1.61.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
