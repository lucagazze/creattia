	.featured-badge {
		position: absolute;
		top: -12px;
		left: 50%;
		transform: translateX(-50%);
		background: linear-gradient(104deg, rgb(62, 134, 198) 0%, rgb(166, 102, 170) 22%, rgb(236, 68, 146) 50%, rgb(238, 68, 84) 76%, rgb(240, 84, 39) 100%);
		color: #FFF;
		font-size: 10px;
		font-weight: 800;
		padding: 4px 12px;
		border-radius: 99px;
		letter-spacing: 0.05em;
