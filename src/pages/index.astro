	/* ==========================================
	   FAQ SECTION
	   ========================================== */
	.faq-section {
		padding: 100px 20px;
		max-width: 800px;
		margin: 0 auto;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 50px;
