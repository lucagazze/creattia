	/* ==========================================
	   FOOTER
	   ========================================== */
	.main-footer {
		background: #FFF;
		padding: 64px 20px 36px;
		display: grid;
		/* En mobile las tres columnas de links iban una debajo de otra y el pie
		   ocupaba una pantalla entera de scroll. Con dos columnas entra de una. */
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 34px 20px;
		max-width: 1100px;
		margin: 0 auto;
