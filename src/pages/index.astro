	/* ==========================================
	   3D CYLINDER CAROUSEL (TryHolo Clone)
	   ========================================== */
	.cylinder-carousel-container {
		width: 100%;
		max-width: min(100vw - 1.5rem, 1920px);
		margin: 60px auto 0;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: visible;
		perspective: var(--carousel-perspective);
		height: var(--carousel-height);
		--carousel-card-w: 220px;
		--carousel-card-h: 380px;
		/* El radio lo calcula el frontmatter según cuántas tarjetas hay. */
		--carousel-radius: var(--carousel-radius-desktop, 540px);
		--carousel-perspective: 1400px;
		--carousel-height: 500px;
	}

	@media (max-width: 809px) {
		.cylinder-carousel-container {
			--carousel-card-w: 140px;
			--carousel-card-h: 240px;
			--carousel-radius: var(--carousel-radius-mobile, 360px);
			--carousel-perspective: 1100px;
			--carousel-height: 340px;
		}
	}

	.carousel-cylinder {
		position: relative;
		transform-style: preserve-3d;
		width: 0;
		height: 0;
		will-change: transform;
	}

	.cylinder-card {
		position: absolute;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
		border: 1px solid var(--border-color);
		background: #ffffff;
		width: var(--carousel-card-w);
		height: var(--carousel-card-h);
		left: calc(var(--carousel-card-w) / -2);
		top: calc(var(--carousel-card-h) / -2);
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
		transform-style: flat;
		clip-path: inset(0 round 20px);
		transition: transform 0.1s ease-out;
	}

	.cylinder-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		max-width: 100%;
		max-height: 100%;
		display: block;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(5px); }
		to { opacity: 1; transform: translateY(0); }
	}

