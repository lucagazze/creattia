	   PRICING SECTION
	   ========================================== */
	.pricing-section {
		padding: 100px 20px;
		background: #FFF;
	}

	/* Opción sin suscripción: pago por imagen + galería */
	.pay-per-use {
		max-width: 1000px;
		margin: 36px auto 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		padding: 28px 32px;
		border: 1px solid var(--border-color);
		border-radius: 24px;
		background: var(--bg-light);
	}

	.ppu-tag {
		display: inline-block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(236, 68, 146);
		margin-bottom: 10px;
	}

	.ppu-text h3 {
		font-size: clamp(18px, 2.4vw, 22px);
		font-weight: 700;
		color: var(--text-dark);
		margin: 0 0 8px;
		letter-spacing: -0.01em;
	}

	.ppu-text p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--text-grey);
		margin: 0;
		max-width: 62ch;
	}

