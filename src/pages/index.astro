	.plan-card h3 {
		font-size: 24px;
		font-weight: 800;
		margin: 0 0 10px;
	}

	.plan-desc {
		font-size: 13px;
		color: var(--text-grey);
		line-height: 1.5;
		margin: 0 0 30px;
		min-height: 40px;
	}

	.plan-price {
		display: flex;
		align-items: flex-end;
		gap: 6px;
		margin-bottom: 20px;
	}

	.plan-price .currency {
		font-size: 14px;
		font-weight: bold;
		color: var(--text-grey);
		margin-bottom: 8px;
	}

	.plan-price .amount {
		font-size: 52px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.plan-price .period {
		font-size: 14px;
		color: var(--text-grey);
		margin-bottom: 8px;
	}

	.plan-credits {
		display: block;
		margin: 0 0 22px;
		font-size: 14px;
		font-weight: 500;
		color: var(--text-grey);
	}

	.plan-credits strong {
		font-weight: 800;
		color: var(--text-dark);
	}

	.plan-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 52px;
		padding: 0 24px;
		border-radius: 26px;
		background: var(--text-dark);
		color: #FFF;
		font-weight: bold;
		text-decoration: none;
		font-size: 14px;
		margin-bottom: 30px;
		transition: opacity 0.2s;
	}

	.plan-card.featured .plan-cta {
		background: linear-gradient(104deg, rgb(62, 134, 198) 0%, rgb(166, 102, 170) 22%, rgb(236, 68, 146) 50%, rgb(238, 68, 84) 76%, rgb(240, 84, 39) 100%);
	}

	.plan-cta:hover {
		opacity: 0.95;
	}

	.plan-features {
		list-style: none;
