---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { subscriptionPlans, YEARLY_PAID_MONTHS } from '../lib/creattia/subscription-plans';
import { showcaseUrl } from '../lib/creattia/showcase';



const ideasRow1 = [
	{ text: 'Nosotros vs Ellos', color: '#8b5cf6' },
	{ text: 'Testimonios', color: '#f97316' },
	{ text: 'Más vendidos', color: '#3b82f6' },
	{ text: 'Multimedia', color: '#a855f7' },
	{ text: 'Gancho negativo', color: '#ef4444' },
	{ text: 'Cazador de mitos', color: '#ec4899' },
	{ text: 'Características', color: '#d946ef' }
];

const ideasRow2 = [
	{ text: 'Notas', color: '#14b8a6' },
	{ text: 'Qué contiene', color: '#f43f5e' },
	{ text: 'Preguntas frecuentes', color: '#06b6d4' },
	{ text: 'Antes y después', color: '#6366f1' },
	{ text: 'Top razones', color: '#2563eb' },
	{ text: 'Problema-solución', color: '#ea580c' },
	{ text: 'Estadísticas', color: '#0284c7' }
];

const steps = [
	{ number: '01', title: 'Ingresá tu URL', copy: 'Pegá el enlace de tu web y la IA de Creattia aprenderá tu marca en minutos.', kind: 'url' },
	{ number: '02', title: 'Deslizá ideas', copy: 'Nuestro creador de contenido con IA te entrega ideas frescas todos los días.', kind: 'ideas' },
	{ number: '03', title: 'Editá y personalizá', copy: 'Cambiá cualquier detalle de la pieza, no necesitas habilidades de diseño.', kind: 'edit' },
	{ number: '04', title: 'Descargá y publicá', copy: 'Lanzá 10x más contenido, 75% más rápido.', kind: 'publish' },
];


// Selección pública de la biblioteca gratuita. Estas son las mismas rutas
// que usa /api/creativos/library.ts para cuentas sin suscripción.
const landingFreeLibraryImages = [
	{ src: showcaseUrl('40/2fb666571bf2802e.png'), label: 'Producto / presentación' },
	{ src: showcaseUrl('40/55596501e64f813b.png'), label: 'Producto / presentación' },
	{ src: showcaseUrl('40/174faa5c6ab2a671.png'), label: 'Producto / presentación' },
	{ src: showcaseUrl('40/8640d4617f2e692d.png'), label: 'Producto / presentación' },
	{ src: showcaseUrl('40/b3aaaa6a8d580a1a.png'), label: 'Producto / presentación' },
	{ src: showcaseUrl('23/ec1000c7e99f98bf.jpg'), label: 'Nosotros vs Ellos' },
	{ src: showcaseUrl('7/c621e734bc3f2b0d.jpg'), label: 'Testimonios' },
	{ src: showcaseUrl('13/8d769523a157558c.jpg'), label: 'Promociones y descuentos' },
	{ src: showcaseUrl('40/1d58518c1d718dd4.webp'), label: 'Producto / presentación' },
	{ src: showcaseUrl('41/fee532dba2b04af0.jpg'), label: 'Características y beneficios' },
	{ src: showcaseUrl('40/9c8d4a8001b24d29.webp'), label: 'Características y beneficios' },
	{ src: showcaseUrl('10/383bfa16d248c64d.png'), label: 'Noticias' },
	{ src: showcaseUrl('40/6115528cf8820436.webp'), label: 'Producto / presentación' },
	{ src: showcaseUrl('19/4e9aee92bbc8b5db.jpg'), label: 'Vacaciones / Estacional' },
];
const landingShowcase = landingFreeLibraryImages;
const landingCylinderImages = landingFreeLibraryImages.map((item) => item.src);

/**
 * Radio del cilindro 3D del carrusel.
 *
 * El efecto buscado es un tambor continuo: las tarjetas unidas formando un
 * círculo que gira. Para eso el radio tiene que ser EXACTAMENTE el que hace que
 * dos tarjetas contiguas se toquen por el borde, (ancho/2) / tan(180°/cantidad).
 *
 * Estaba fijo en 420 con 14 tarjetas de 220px, por debajo de ese valor: las
 * tarjetas se encimaban y cada una tapaba el contenido de la siguiente. Con un
 * radio mayor al exacto quedan separadas y se pierde el tambor. Se calcula, así
 * que sigue cerrando si se agregan o sacan imágenes.
 */
const cylinderRadius = (cardWidth: number, gap: number) =>
	Math.round(((cardWidth + gap) / 2) / Math.tan(Math.PI / landingCylinderImages.length));
/**
 * Una rendija chica entre tarjetas: sin ella el tambor es una pared cerrada y
 * no se percibe que gira; con demasiada, las tarjetas se leen sueltas y se
 * pierde el círculo. 10px deja ver el fondo entre una y otra sin romperlo.
 */
const CYLINDER_GAP_DESKTOP = 10;
const CYLINDER_GAP_MOBILE = 8;
const cylinderRadiusDesktop = cylinderRadius(220, CYLINDER_GAP_DESKTOP);
const cylinderRadiusMobile = cylinderRadius(140, CYLINDER_GAP_MOBILE);

const plans = subscriptionPlans.map((plan) => ({
	...plan,
	priceLabel: plan.price.toFixed(2),
	cta: plan.code === 'free' ? 'Explorar gratis' : `Elegir ${plan.name}`,
	href: `/app/?plan=${plan.code}`,
}));


const testimonials = [
	{ name: 'Martina Ferreyra', country: 'Argentina', date: '18 feb 2026', text: 'Tengo una marca de skincare en Córdoba y antes pagaba un diseñador por cada anuncio. Ahora pego el link del producto, elijo un anuncio que ya funcionó y en minutos tengo la versión con mi marca. Cambió totalmente mi forma de armar campañas.' },
	{ name: 'Rodrigo Bogado', country: 'Paraguay', date: '4 mar 2026', text: 'Vendo indumentaria deportiva en Asunción y probaba anuncio tras anuncio a mano en Canva. Con Creattia clono los que ya son ganadores de otras marcas del rubro y los adapto a la mía. Bajó muchísimo mi costo por creativo en Meta.' },
	{ name: 'Javiera Muñoz', country: 'Chile', date: '22 mar 2026', text: 'Lo que más me sorprendió es que respeta los datos reales de mi producto, no inventa precios ni promociones. Uso la biblioteca de ganadores todas las semanas para renovar los anuncios antes de que se cansen.' },
	{ name: 'Sofía Etcheverry', country: 'Uruguay', date: '9 abr 2026', text: 'Tengo un local de decoración en Montevideo y nunca fui de manejar Photoshop. Con la versión de carrusel armé en un rato el mismo formato que usa una marca grande, pero con mis productos y mis fotos.' },
	{ name: 'Ignacio Pizarro', country: 'Chile', date: '30 abr 2026', text: 'Empecé con las 3 imágenes gratis para probar y a la semana ya estaba suscripto. El generador por URL me trajo referencias de mi mismo nicho que ni sabía que existían, y algunas terminaron siendo mis anuncios con mejor rendimiento del mes.' },
	{ name: 'Camila Sosa', country: 'Argentina', date: '12 may 2026', text: 'Manejo las redes de dos marcas de indumentaria y la función de guardar la identidad de cada una me ahorra un montón de tiempo. Genero el lote de anuncios de la semana en menos de lo que tardaba en pensar un solo copy.' }
];

const faqs = [
	{ q: '¿Qué es Creattia?', a: 'Creattia es tu herramienta de marketing todo en uno con IA. Crea anuncios, publicaciones para redes sociales e imágenes de producto que suenan y se ven como si vinieran de tu propio equipo. Sin plantillas. Sin relleno genérico. Solo campañas perfectas listas para lanzar.' },
	{ q: '¿Cómo se diferencia Creattia de otras herramientas de IA?', a: 'Creattia está construida para rendimiento real de marketing, no para resultados genéricos. Aprende el ADN de tu marca (estilo, disparadores de compra y público objetivo), está entrenada en más de 19,000 anuncios de alto rendimiento y soporta múltiples formatos listos para usar sin necesidad de redactar prompts.' },
	{ q: '¿Necesito conocimientos técnicos o de diseño?', a: 'No. Creattia fue diseñada para fundadores, creadores y profesionales de marketing que buscan velocidad y resultados reales sin curvas de aprendizaje complejas.' },
	{ q: '¿Qué tipo de contenido puede generar?', a: 'Genera anuncios estáticos, imágenes para redes sociales e imágenes de productos, todo alineado con la identidad y el tono de tu marca.' },
	{ q: '¿Puedo gestionar múltiples marcas en una sola cuenta?', a: 'Sí. Podés configurar y gestionar múltiples marcas en tu cuenta, cada una con su propio ADN de marca, biblioteca de productos y plantillas separadas.' },
	{ q: '¿Tienen prueba gratis?', a: 'Sí. Podés registrarte de forma gratuita y obtener 3 imágenes de prueba sin necesidad de tarjeta para experimentar el flujo de trabajo completo.' }
];

---

<Layout
	title="Creattia | La plataforma N°1 para generar imágenes que venden"
	description="Convertí tu web y tus productos en imágenes publicitarias listas para vender. Sin diseñar ni escribir prompts."
	ogTitle="Creattia | Imágenes publicitarias para tu negocio"
	ogDescription="Elegí una idea, sumá tu producto y generá imágenes listas para publicar."
>
	<link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" crossorigin="anonymous" type="font/woff2" slot="head" />
	<link rel="preload" href="/fonts/Satoshi-VariableItalic.woff2" as="font" crossorigin="anonymous" type="font/woff2" slot="head" />
	<link rel="preload" href="/fonts/Wonderkids-Regular.ttf" as="font" crossorigin="anonymous" type="font/ttf" slot="head" />

	<!-- Header de Navegación -->
	<header class="floating-header" aria-label="Navegación principal">
		<a class="logo-bubble" href="#inicio" aria-label="Creattia, volver al inicio">
			<img src="/images/creattia/avatar-nobg.webp" alt="Creattia Logo" width="1254" height="1254" decoding="async"/>
		</a>
		<nav class="nav-links">
			<a href="#como-funciona">Cómo funciona</a>
			<a href="#biblioteca">Biblioteca</a>
			<a href="#precios">Precios</a>
			<a href="/app/">Ingresar</a>
		</nav>
		<div class="header-actions">
			<a class="outline-cta" href="/app/">Empezar gratis <span>→</span></a>
			<a class="header-cta-mobile" href="/app/">Empezar gratis</a>
			<button class="mobile-menu-toggle" aria-label="Abrir menú" id="mobile-toggle">
				<span></span><span></span><span></span>
			</button>
		</div>
	</header>

	<!-- Menú móvil colapsable -->
	<div class="mobile-nav-overlay" id="mobile-overlay">
		<nav class="mobile-nav">
			<a href="#como-funciona" class="mobile-nav-link">Cómo funciona</a>
			<a href="#biblioteca" class="mobile-nav-link">Biblioteca</a>
			<a href="#precios" class="mobile-nav-link">Precios</a>
			<a href="/app/" class="mobile-nav-link">Ingresar</a>
			<a class="mobile-cta" href="/app/">Empezar gratis</a>
		</nav>
	</div>

	<main class="landing-content">
		<!-- Hero Section -->
		<section class="hero-section" id="inicio">
			<div class="hero-wrapper">
				<div class="hero-content-block">
					<div class="hero-badge-container">
						<div class="hero-badge">
							<span class="hero-badge-text">IA PARA MARKETING</span>
						</div>
					</div>
					<h1 class="hero-title" aria-label="Más de 3000 anuncios ganadores para tu negocio"><span>+3000 anuncios ganadores</span><span>para tu negocio</span></h1>
					<p class="hero-subtitle">Elegí un anuncio que ya está funcionando y Creattia lo recrea con tu producto: creativos de alto rendimiento, listos para publicar en minutos.</p>
					<a class="gradient-cta hero-primary-cta" href="/app/">
						<span>Empezar gratis</span>
						<svg class="cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg>
					</a>
					</div>
				<!-- Hero Video Container matching TryHolo look -->
				<div class="hero-video-container">
					<div class="video-border-effect"></div>
					<video autoplay muted loop playsinline preload="metadata" aria-label="Demostración de Creattia">
						<source src="/videos/creattia-hero-4x3.mp4" type="video/mp4" />
					</video>
				</div>

				<div class="hero-rating-wrapper">
					<div class="rating-stars">
						<div class="avatars-group">
							<img class="rating-avatar-img" src="/landing/SocialProof-footer-1.webp" alt="User 1" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="/landing/SocialProof-footer-2.webp" alt="User 2" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="/landing/SocialProof-footer-3.webp" alt="User 3" decoding="async" loading="lazy"/>
							<img class="rating-avatar-img" src="/landing/SocialProof-footer-4.webp" alt="User 4" decoding="async" loading="lazy"/>
						</div>
						<span class="rating-text"><strong>4.9</strong>/5 de más de <strong>4268</strong> clientes</span>
						<img class="rating-star-icon" src="/landing/SocialProof-startIcon.avif" alt="Star" decoding="async" loading="lazy"/>
					</div>
				</div>
			</div>
		</section>

		<!-- Showcase Section (TryHolo Clone) -->
		<section class="showcase-section" id="biblioteca">
			<div class="showcase-container">
				<div class="showcase-header-wrapper">
					<h2 class="banner-heading">Probablemente ya viste nuestro trabajo.<br/>Solo que no sabías que era IA.</h2>
				</div>

				<div class="showcase-marquee" aria-label="Ejemplos de la biblioteca de Creattia" aria-roledescription="carrusel" tabindex="0">
					<div class="showcase-track">
						{[...landingShowcase, ...landingShowcase, ...landingShowcase].map((item, index) => (
							<div
								class="showcase-card"
								data-showcase-index={index}
								aria-hidden={index < landingShowcase.length || index >= landingShowcase.length * 2 ? 'true' : undefined}
							>
								<img src={item.src} alt={`Ejemplo de ${item.label}`} decoding="async" loading="lazy"/>
							</div>
						))}
					</div>
				</div>
				
				<div class="showcase-footer-nav">
					<div class="carousel-nav-arrows">
						<button class="arrow-nav-btn prev-btn" aria-label="Anterior">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
						</button>
						<button class="arrow-nav-btn next-btn" aria-label="Siguiente">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Manifesto Section with Inline Animating Videos (TryHolo Clone) -->
		<section class="manifesto-section">
			<div class="manifesto-container">
				<p class="manifesto-line">
					En Creattia estamos revolucionando cómo los creadores producen
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="/landing/integrationText-Bulb.mp4" type="video/mp4" />
						</video>
					</span>
					contenido.
				</p>
				<p class="manifesto-line">
					Usando los últimos modelos de IA capturamos
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="/landing/integrationText-brain.mp4" type="video/mp4" />
						</video>
					</span>
					la esencia de tu marca para entregar creativos de nivel de agencia en todas las
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="/landing/integrationText-socials.mp4" type="video/mp4" />
						</video>
					</span>
					plataformas.
				</p>
				<p class="manifesto-line">
					Para que puedas hacer el trabajo de un equipo completo
					<span class="inline-video-wrapper">
						<video autoplay loop muted playsinline preload="metadata">
							<source src="/landing/integrationText-team.mp4" type="video/mp4" />
						</video>
					</span>
					sin contratar uno.
				</p>
			</div>
		</section>

		<!-- Product Video Walkthrough Section (TryHolo Clone) -->
		<section class="walkthrough-video-section">
			<div class="walkthrough-video-wrapper">
				<div class="walkthrough-video-container">
					<video autoplay muted loop playsinline preload="metadata">
						<source src="https://czocbnyoenjbpxmcqobn.supabase.co/storage/v1/object/public/creattia-media/walkthrough.mp4" type="video/mp4" />
					</video>
				</div>
			</div>
		</section>

		<!-- How It Works Section (TryHolo Vertical Clone) -->
		<section class="how-it-works" id="como-funciona">
			<div class="section-header">
				<span class="section-tag font-bold">CÓMO FUNCIONA</span>
				<h2>De tu web a una imagen lista para vender.</h2>
			</div>
			
			<div class="steps-vertical-container">
				{steps.map((step, idx) => (
					<div class="step-vertical-row">
						<!-- Left indicator column -->
						<div class="step-left-line-col">
							<span class="step-vertical-number">{step.number}</span>
							{idx < steps.length - 1 && (
								<div class="step-vertical-line" style={`background-image: linear-gradient(to bottom, ${idx === 0 ? '#3e86c6, #a666aa' : idx === 1 ? '#a666aa, #ec4492' : '#ee4454, #f05427'})`}></div>
							)}
						</div>
						
						<!-- Content and Demo columns -->
						<div class="step-vertical-content-wrapper">
							<div class="step-vertical-text">
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</div>
							
							{step.kind !== 'publish' && (
								<div class="step-vertical-demo-box">
									{step.kind === 'url' && (
										<video autoplay loop muted playsinline class="step-video-demo">
											<source src="/landing/howItWorks-inputUrl.webm" type="video/webm" />
										</video>
									)}
									{step.kind === 'ideas' && (
										<video autoplay loop muted playsinline class="step-video-demo">
											<source src="/landing/howItWorks-SwipeIdeas.webm" type="video/webm" />
										</video>
									)}
									{step.kind === 'edit' && (
										<video autoplay loop muted playsinline class="step-video-demo">
											<source src="/landing/howItWorks-Edit.webm" type="video/webm" />
										</video>
									)}
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- The All-in-One Marketing Tool Section (TryHolo 3D Cylinder Clone) -->
		<section class="all-in-one-section">
			<div class="section-header max-w-[800px] margin-auto">
				<span class="section-tag">LA HERRAMIENTA TODO EN UNO</span>
				<h2>La herramienta de marketing todo en uno.</h2>
				<p class="section-desc">Olvidate de las herramientas complejas, plantillas y pestañas. Creattia es la IA para tu marketing, diseñada para escalar tu negocio en piloto automático.</p>
			</div>

			<div
				class="cylinder-carousel-container"
				style={`--carousel-radius-desktop: ${cylinderRadiusDesktop}px; --carousel-radius-mobile: ${cylinderRadiusMobile}px;`}
			>
				<div class="carousel-cylinder">
					{landingCylinderImages.map((src, idx) => {
						const angle = idx * (360 / landingCylinderImages.length);
						return (
							<div 
								class="cylinder-card" 
								style={`transform: rotateY(${angle}deg) translateZ(var(--carousel-radius));`}
							>
								<img src={src} alt={`Ejemplo creativo ${idx + 1}`} decoding="async" loading="lazy"/>
							</div>
						);
					})}
				</div>
			</div>
		</section>

		<!-- Brand DNA Section -->
		<section class="brand-dna-section">
			<div class="section-header max-w-[800px] margin-auto">
				<span class="section-tag">IMPULSADO POR</span>
				<h2>El ADN de tu marca.</h2>
				<p class="section-desc">Creattia aprende lo que hace reconocible a tu negocio y lo reutiliza automáticamente cada vez que creás.</p>
			</div>

			<div class="dna-grid">
				<article class="dna-card style-card">
					<h3>Captura tu Estilo</h3>
					<p>Colores, tono, composición y forma de presentar tus productos.</p>
					<div class="color-dots-simulate">
						<span style="background: #3e86c6"></span>
						<span style="background: #a666aa"></span>
						<span style="background: #ec4492"></span>
						<span style="background: #ee4454"></span>
						<span style="background: #f05427"></span>
					</div>
				</article>

				<article class="dna-card triggers-card">
					<h3>Aprende Disparadores</h3>
					<p>Beneficios, urgencia, prueba social y argumentos comerciales de tu marca.</p>
					<div class="triggers-row" style="display: flex; gap: 8px; margin-top: 16px;">
						<img src="/landing/brandDna-triggerGreen.avif" alt="Disparador Verde" style="height: 32px; width: auto;" decoding="async" loading="lazy"/>
						<img src="/landing/brandDna-triggerYellow.avif" alt="Disparador Amarillo" style="height: 32px; width: auto;" decoding="async" loading="lazy"/>
						<img src="/landing/brandDna-triggerRed.avif" alt="Disparador Rojo" style="height: 32px; width: auto;" decoding="async" loading="lazy"/>
					</div>
				</article>

				<div class="dna-mascot-card">
					<div class="mascot-bg-glow"></div>
					<video autoplay muted loop playsinline class="dna-mascot-video" style="width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 20px;">
						<source src="/landing/brandDna-mascotVideo.mp4" type="video/mp4" />
					</video>
				</div>

				<article class="dna-card audience-card">
					<h3>Conoce a tu Audiencia</h3>
					<p>Adapta la jerarquía visual al tipo de comunicación y al cliente ideal.</p>
					<div class="social-icons-row" style="display: flex; gap: 10px; margin-top: 16px;">
						<img src="/landing/brandDna-fb.avif" alt="Facebook" style="width: 30px; height: 30px; border-radius: 6px;" decoding="async" loading="lazy"/>
						<img src="/landing/brandDna-ig.avif" alt="Instagram" style="width: 30px; height: 30px; border-radius: 6px;" decoding="async" loading="lazy"/>
						<img src="/landing/brandDna-tiktok.avif" alt="TikTok" style="width: 30px; height: 30px; border-radius: 6px;" decoding="async" loading="lazy"/>
						<img src="/landing/brandDna-twitter.avif" alt="Twitter" style="width: 30px; height: 30px; border-radius: 6px;" decoding="async" loading="lazy"/>
					</div>
				</article>

				<article class="dna-card private-card">
					<h3>Datos 100% Privados</h3>
					<p>Tus productos, marca y piezas generadas están seguras en tu espacio de trabajo.</p>
					<div class="privacy-lock-row" style="display: flex; align-items: center; gap: 8px; margin-top: 16px;">
