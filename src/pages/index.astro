    estilos: al unificarlo, esta habría dibujado un segundo cartel encima del
    otro en la landing. Además guardaba el "entendido" en localStorage, o sea
    para siempre — quien lo cerró una vez sin entenderlo se quedaba con la
    página ilegible y sin forma de volver a leer cómo arreglarlo. */}

<script is:inline>
	// Zoom desactivado en la landing.
	//
	// El meta viewport ya lleva user-scalable=no, pero iOS Safari lo ignora desde
	// iOS 10: en iPhone se seguía pudiendo pellizcar y hacer doble toque. La clase
	// se agrega desde JS a propósito: si el script no corre, la página sigue
	// siendo ampliable en vez de quedar bloqueada por CSS.
	document.documentElement.classList.add('sin-zoom');
	// Safari en iOS dispara estos eventos propios en vez de respetar el viewport.
	for (const evento of ['gesturestart', 'gesturechange', 'gestureend']) {
		document.addEventListener(evento, (e) => e.preventDefault(), { passive: false });
	}
	// Pellizco con dos dedos donde no hay eventos de gesto (Android, iPadOS).
	document.addEventListener('touchmove', (e) => {
		if (e.touches.length > 1) e.preventDefault();
	}, { passive: false });
	// Doble toque: solo se frena si llega antes de 300 ms del toque anterior.
	let ultimoToque = 0;
	document.addEventListener('touchend', (e) => {
		const ahora = Date.now();
		if (ahora - ultimoToque < 300) e.preventDefault();
		ultimoToque = ahora;
	}, { passive: false });
</script>
</Layout>

<script>
	// Lógica interactiva para cambiar de pestañas en "All-in-One"
	const tabButtons = document.querySelectorAll('[data-tab-target]');
	const tabPanels = document.querySelectorAll('[data-tab-panel]');

	tabButtons.forEach(button => {
		button.addEventListener('click', () => {
			const targetId = button.getAttribute('data-tab-target');

			// Actualizar botones
			tabButtons.forEach(btn => {
				btn.setAttribute('aria-selected', btn === button ? 'true' : 'false');
			});

			// Actualizar paneles
			tabPanels.forEach(panel => {
				if (panel.id === targetId) {
					panel.removeAttribute('hidden');
				} else {
					panel.setAttribute('hidden', '');
				}
			});
		});
	});

	// Menú móvil
	const mobileToggle = document.getElementById('mobile-toggle');
	const mobileOverlay = document.getElementById('mobile-overlay');

	if (mobileToggle && mobileOverlay) {
		mobileToggle.addEventListener('click', () => {
			mobileToggle.classList.toggle('active');
			mobileOverlay.classList.toggle('active');
			document.body.classList.toggle('menu-open');
		});

		// Cerrar menú al hacer clic en enlaces del menú
		const mobileLinks = mobileOverlay.querySelectorAll('.mobile-nav-link');
		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileToggle.classList.remove('active');
				mobileOverlay.classList.remove('active');
				document.body.classList.remove('menu-open');
			});
		});
	}

	// Efecto 3D Scroll Perspective en el Video Walkthrough
	const walkthroughVideo = document.querySelector('.walkthrough-video-container') as HTMLElement | null;
	if (walkthroughVideo) {
		const updatePerspective = () => {
			const rect = walkthroughVideo.getBoundingClientRect();
			const windowHeight = window.innerHeight;
			const progress = Math.min(Math.max((windowHeight - rect.top) / (0.8 * windowHeight), 0), 1);
			const inverse = 1 - progress;
			const scale = 1 + 0.12 * inverse;
			const rotateX = 15 * inverse;
			
			walkthroughVideo.style.transform = `perspective(1000px) rotateX(${rotateX}deg) scale(${scale})`;
			walkthroughVideo.style.opacity = String(0.4 + 0.6 * progress);
			walkthroughVideo.style.transition = 'transform 0.1s ease-out, opacity 0.1s ease-out';
		};
		window.addEventListener('scroll', updatePerspective);
		window.addEventListener('resize', updatePerspective);
		updatePerspective();
	}

	// Lógica de Scroll de Showcase Carousel (Auto-scroll + Manual + Drag)
	/* const track = document.querySelector('.showcase-marquee') as HTMLElement | null;
	const prevBtn = document.querySelector('.prev-btn');
	const nextBtn = document.querySelector('.next-btn');
	if (false && track && prevBtn && nextBtn) {
		const cardWidth = 300; // 280px card + 20px gap
		
		const scrollNext = () => {
			const maxScrollLeft = track.scrollWidth - track.clientWidth;
			if (track.scrollLeft >= maxScrollLeft - 10) {
				track.scrollTo({ left: 0, behavior: 'smooth' });
			} else {
				track.scrollBy({ left: cardWidth, behavior: 'smooth' });
			}
		};
		
		const scrollPrev = () => {
			if (track.scrollLeft <= 10) {
				track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
			} else {
				track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
			}
		};
		
		prevBtn.addEventListener('click', () => {
			scrollPrev();
			resetAutoScroll();
		});
		nextBtn.addEventListener('click', () => {
			scrollNext();
			resetAutoScroll();
		});
		
		// Auto-scroll cada 3 segundos
		let autoScrollInterval = setInterval(scrollNext, 3000);
		
		const resetAutoScroll = () => {
			clearInterval(autoScrollInterval);
			autoScrollInterval = setInterval(scrollNext, 3000);
		};

		// DRAG-TO-SCROLL (Grab to slide) — al soltar, siempre encastra en la
		// tarjeta más cercana. Sin esto el arrastre podía dejar el carrusel a
		// mitad de camino entre dos tarjetas, cortadas y feas.
		let isDown = false;
		let startX: number;
		let scrollLeft: number;
		let dragged = false;

		const snapToNearestCard = () => {
			const maxScrollLeft = track.scrollWidth - track.clientWidth;
			const nearest = Math.min(maxScrollLeft, Math.max(0, Math.round(track.scrollLeft / cardWidth) * cardWidth));
			track.style.scrollBehavior = 'smooth';
			track.scrollTo({ left: nearest, behavior: 'smooth' });
		};

		const endDrag = () => {
			if (!isDown) return;
			isDown = false;
			track.style.cursor = 'grab';
			track.style.userSelect = '';
			if (dragged) snapToNearestCard();
			resetAutoScroll(); // Resume auto-scroll
		};

		track.addEventListener('mousedown', (e: MouseEvent) => {
			isDown = true;
			dragged = false;
			track.style.scrollBehavior = 'auto'; // Disable smooth-scroll animation during dragging
			track.style.cursor = 'grabbing';
			track.style.userSelect = 'none';
			startX = e.pageX - track.offsetLeft;
			scrollLeft = track.scrollLeft;
			clearInterval(autoScrollInterval); // Pause auto-scroll while dragging
		});

		track.addEventListener('mouseleave', endDrag);
		track.addEventListener('mouseup', endDrag);

		track.addEventListener('mousemove', (e: MouseEvent) => {
			if (!isDown) return;
			e.preventDefault();
			dragged = true;
			const x = e.pageX - track.offsetLeft;
			const walk = (x - startX) * 1.5; // multiplier for speed
			track.scrollLeft = scrollLeft - walk;
		});

		// Touch events
		track.addEventListener('touchstart', (e: TouchEvent) => {
			isDown = true;
			dragged = false;
			track.style.scrollBehavior = 'auto'; // Disable smooth-scroll during touch drag
			startX = e.touches[0].pageX - track.offsetLeft;
			scrollLeft = track.scrollLeft;
			clearInterval(autoScrollInterval);
		}, { passive: true });

		track.addEventListener('touchend', endDrag);

		track.addEventListener('touchmove', (e: TouchEvent) => {
			if (!isDown) return;
			dragged = true;
			const x = e.touches[0].pageX - track.offsetLeft;
			const walk = (x - startX) * 1.5;
			track.scrollLeft = scrollLeft - walk;
		}, { passive: true });
	}

	// Lógica de Rotación 3D del Cylinder Carousel (All-in-One)
	// Showcase carousel: una página por gesto, navegación con snap y autoplay suave.
	*/
	const showcaseTrack = document.querySelector('.showcase-marquee') as HTMLElement | null;
	const showcasePrev = document.querySelector('.prev-btn') as HTMLButtonElement | null;
	const showcaseNext = document.querySelector('.next-btn') as HTMLButtonElement | null;
	if (showcaseTrack && showcasePrev && showcaseNext) {
		const showcaseCards = Array.from(showcaseTrack.querySelectorAll<HTMLElement>('.showcase-card'));
		const originalCount = Math.floor(showcaseCards.length / 3);
		let currentIndex = originalCount;
		let autoScrollTimer: number | undefined;
		let settleTimer: number | undefined;
		let pointerId: number | null = null;
		let startX = 0;
		let startY = 0;
		let startScrollLeft = 0;
		let startIndex = currentIndex;
		let lastX = 0;
		let lastMoveAt = 0;
		let isDragging = false;
		let isPointerOver = false;

		const clampIndex = (index: number) => Math.max(0, Math.min(showcaseCards.length - 1, index));
		const leftForIndex = (index: number) => {
			const card = showcaseCards[clampIndex(index)];
			const maxScrollLeft = Math.max(0, showcaseTrack.scrollWidth - showcaseTrack.clientWidth);
			return Math.min(maxScrollLeft, Math.max(0, card?.offsetLeft ?? 0));
		};
		const nearestIndex = () => {
			let nearest = currentIndex;
			let nearestDistance = Number.POSITIVE_INFINITY;
			showcaseCards.forEach((card, index) => {
				const distance = Math.abs(card.offsetLeft - showcaseTrack.scrollLeft);
				if (distance < nearestDistance) {
					nearest = index;
					nearestDistance = distance;
				}
			});
			return nearest;
		};
		const normalizeLoopPosition = () => {
			if (currentIndex >= originalCount * 2) currentIndex -= originalCount;
			if (currentIndex < originalCount) currentIndex += originalCount;
			showcaseTrack.scrollTo({ left: leftForIndex(currentIndex), behavior: 'auto' });
		};
		const scheduleLoopNormalization = () => {
			window.clearTimeout(settleTimer);
			settleTimer = window.setTimeout(normalizeLoopPosition, 720);
		};
		const goTo = (requestedIndex: number) => {
			if (!originalCount) return;
			let targetIndex = requestedIndex;
			let behavior: ScrollBehavior = 'smooth';
			// Hay tres copias consecutivas: al cruzar un extremo saltamos al
			// mismo elemento de la copia central sin que el usuario lo perciba.
			if (targetIndex < 0) {
				targetIndex = originalCount * 2 - 1;
				behavior = 'auto';
			} else if (targetIndex >= showcaseCards.length) {
				targetIndex = originalCount;
				behavior = 'auto';
			}
			currentIndex = clampIndex(targetIndex);
			showcaseTrack.scrollTo({ left: leftForIndex(currentIndex), behavior });
			scheduleLoopNormalization();
		};
		const scrollNext = () => goTo(currentIndex + 1);
		const scrollPrev = () => goTo(currentIndex - 1);
		const clearAutoScroll = () => {
			window.clearInterval(autoScrollTimer);
			autoScrollTimer = undefined;
		};
		const startAutoScroll = () => {
			clearAutoScroll();
			if (document.hidden || isPointerOver || isDragging) return;
			autoScrollTimer = window.setInterval(scrollNext, 4500);
		};
		const resetAutoScroll = () => {
			clearAutoScroll();
			window.setTimeout(startAutoScroll, 900);
		};
		const releasePointer = () => {
			if (pointerId !== null && showcaseTrack.hasPointerCapture(pointerId)) showcaseTrack.releasePointerCapture(pointerId);
			pointerId = null;
			showcaseTrack.classList.remove('is-dragging');
			showcaseTrack.style.userSelect = '';
			showcaseTrack.style.scrollBehavior = '';
		};
		const endPointerGesture = (event: PointerEvent) => {
			if (pointerId !== event.pointerId) return;
			const deltaX = event.clientX - startX;
			const elapsed = Math.max(1, performance.now() - lastMoveAt);
			const velocity = (event.clientX - lastX) / elapsed;
			const shouldAdvance = Math.abs(deltaX) > Math.max(42, showcaseTrack.clientWidth * 0.1) || Math.abs(velocity) > 0.45;
			if (isDragging) {
				const direction = deltaX < 0 ? 1 : -1;
				goTo(shouldAdvance ? startIndex + direction : nearestIndex());
			}
			isDragging = false;
			releasePointer();
			resetAutoScroll();
		};

		requestAnimationFrame(() => {
			showcaseTrack.scrollTo({ left: leftForIndex(currentIndex), behavior: 'auto' });
		});
		showcasePrev.addEventListener('click', () => { scrollPrev(); resetAutoScroll(); });
		showcaseNext.addEventListener('click', () => { scrollNext(); resetAutoScroll(); });
		showcaseTrack.addEventListener('mouseenter', () => { isPointerOver = true; clearAutoScroll(); });
		showcaseTrack.addEventListener('mouseleave', () => { isPointerOver = false; startAutoScroll(); });
		showcaseTrack.addEventListener('focusin', clearAutoScroll);
		showcaseTrack.addEventListener('focusout', startAutoScroll);
		showcaseTrack.addEventListener('pointerdown', (event: PointerEvent) => {
			if (event.pointerType === 'mouse' && event.button !== 0) return;
			pointerId = event.pointerId;
			startX = event.clientX;
			startY = event.clientY;
			lastX = startX;
			lastMoveAt = performance.now();
			startScrollLeft = showcaseTrack.scrollLeft;
			startIndex = nearestIndex();
			isDragging = false;
			clearAutoScroll();
			showcaseTrack.setPointerCapture(event.pointerId);
		});
		showcaseTrack.addEventListener('pointermove', (event: PointerEvent) => {
			if (pointerId !== event.pointerId) return;
			const deltaX = event.clientX - startX;
			const deltaY = event.clientY - startY;
			if (!isDragging) {
				if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 8) return;
				if (Math.abs(deltaY) > Math.abs(deltaX)) {
					releasePointer();
					startAutoScroll();
					return;
				}
				isDragging = true;
				showcaseTrack.classList.add('is-dragging');
				showcaseTrack.style.scrollBehavior = 'auto';
				showcaseTrack.style.userSelect = 'none';
			}
			if (isDragging) {
				event.preventDefault();
				showcaseTrack.scrollLeft = startScrollLeft - deltaX;
				lastX = event.clientX;
				lastMoveAt = performance.now();
			}
		});
		showcaseTrack.addEventListener('pointerup', endPointerGesture);
		showcaseTrack.addEventListener('pointercancel', endPointerGesture);
		showcaseTrack.addEventListener('keydown', (event: KeyboardEvent) => {
			if (event.key === 'ArrowLeft') { event.preventDefault(); scrollPrev(); resetAutoScroll(); }
			if (event.key === 'ArrowRight') { event.preventDefault(); scrollNext(); resetAutoScroll(); }
		});
		document.addEventListener('visibilitychange', () => document.hidden ? clearAutoScroll() : startAutoScroll());
		startAutoScroll();
	}

	const cylinder = document.querySelector('.carousel-cylinder') as HTMLElement | null;
	if (cylinder) {
		let angle = 0;
		let lastTime = performance.now();
		
		const animate = (time: number) => {
			const delta = time - lastTime;
			lastTime = time;
			
			// Rotar la base por una cantidad fija por milisegundo (-0.006 grados/ms)
			angle = (angle - 0.006 * delta) % 360;
			cylinder.style.transform = `rotateY(${angle}deg)`;
			
			requestAnimationFrame(animate);
		};
		
		requestAnimationFrame(animate);
	}
</script>

