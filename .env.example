# Supabase — variables públicas del navegador
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase — solo servidor, nunca exponer en el cliente
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# OpenAI — solo servidor
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# Runway — solo servidor, necesario para Gemini Omni Flash Video-to-Video
GOOGLE_AI_API_KEY=AIza...
# Solo para consultar trabajos antiguos o habilitar Runway como respaldo.
RUNWAYML_API_SECRET=key_...

# Mercado Pago — solo servidor
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# Opcionales: si se omiten, Creattia crea la suscripción mensual directamente
# con el precio correspondiente al plan.
MERCADO_PAGO_PLAN_CREATOR_ID=your_creator_preapproval_plan_id
MERCADO_PAGO_PLAN_PRO_ID=your_pro_preapproval_plan_id
MERCADO_PAGO_PLAN_SCALE_ID=your_scale_preapproval_plan_id
MERCADO_PAGO_PLAN_AGENCY_ID=your_agency_preapproval_plan_id
MERCADO_PAGO_PLAN_ID=your_creator_preapproval_plan_id
MERCADO_PAGO_PLAN_CREATOR_YEARLY_ID=your_creator_yearly_preapproval_plan_id
MERCADO_PAGO_PLAN_PRO_YEARLY_ID=your_pro_yearly_preapproval_plan_id
MERCADO_PAGO_PLAN_SCALE_YEARLY_ID=your_scale_yearly_preapproval_plan_id
MERCADO_PAGO_PLAN_AGENCY_YEARLY_ID=your_agency_yearly_preapproval_plan_id
MERCADO_PAGO_PLAN_YEARLY_ID=your_creator_yearly_preapproval_plan_id
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret
MERCADO_PAGO_CURRENCY=USD
# Las suscripciones de cuentas argentinas se cobran en ARS aunque la app
# mantenga sus precios comerciales expresados en USD.
MERCADO_PAGO_SUBSCRIPTION_CURRENCY=ARS
MERCADO_PAGO_ARS_PER_USD=1515
# El plan Creator debe ser el plan Básico de USD 9.99/mes. El precio de las
# compras extra está fijado en código en USD 0.30 por crédito.
CREDIT_CURRENCY=USD

# Cuentas administradoras, separadas por coma. Si se omite, se usa la cuenta
# original del proyecto. Son cuentas con créditos infinitos y control de la
# biblioteca: conviene mantener la lista corta.
ADMIN_EMAILS=algoritmiadesarrollos@gmail.com

# URL pública, sin barra final
PUBLIC_SITE_URL=https://creattia.app
