		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 52px;
		padding: 0 26px;
		border-radius: 26px;
		background: var(--holo-gradient);
		color: #FFF;
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 6px 18px rgba(236, 68, 146, 0.22);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.ppu-cta:hover {
		transform: scale(1.03);
		box-shadow: 0 10px 26px rgba(236, 68, 146, 0.32);
	}

	@media (max-width: 700px) {
		.pay-per-use {
			flex-direction: column;
			align-items: flex-start;
			padding: 24px;
		}
		.ppu-cta {
			width: 100%;
			justify-content: center;
		}
	}

	/* Cinco planes en 1200px con 24px de aire dejaban 220px por tarjeta, y con el
	   padding lateral quedaban 156px de contenido: se veían angostas y las
	   descripciones caían en cuatro renglones. Menos separación y un poco más de
	   ancho útil dan casi 40px más por tarjeta, que es lo que hace que el bloque
	   se lea como una fila de tarjetas y no como cinco columnas apretadas. */
	.plans-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		max-width: 1280px;
		margin: 60px auto 0;
		align-items: stretch;
	}

	@media (min-width: 768px) {
		.plans-grid {
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		}
	}

	@media (min-width: 1100px) {
		/* Son cinco planes. Con cuatro columnas el quinto bajaba solo a una fila
		   propia, descolgado del resto. */
		.plans-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}

	.plan-card {
		background: #FFF;
		border: 1px solid var(--border-color);
		border-radius: 28px;
		padding: 36px 24px;
		position: relative;
		display: flex;
		flex-direction: column;
		box-shadow: 0 10px 30px rgba(0,0,0,0.02);
		transition: transform 0.2s, box-shadow 0.2s;
