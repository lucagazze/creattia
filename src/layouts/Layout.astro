---
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  favicon?: string;
  appleTouchIcon?: string;
  manifest?: string;
}

const {
  title,
  description = 'Creattia genera imágenes publicitarias con inteligencia artificial usando tus productos y la identidad de tu negocio.',
  noindex = false,
  ogTitle = 'Creattia | Imágenes con IA que venden',
  ogDescription = 'Elegí una idea, sumá tu producto y generá una imagen lista para publicar. Sin diseñar ni escribir prompts.',
  // 1200x630 real. Antes apuntaba al avatar, que es cuadrado de 500px: las
  // etiquetas declaraban 1200x630 y WhatsApp, Facebook y X recortaban o
  // directamente descartaban la miniatura por no coincidir con lo declarado.
  ogImage = '/images/creattia/og-image.png',
  favicon = '/images/creattia/favicon.ico',
  appleTouchIcon = '/images/creattia/apple-touch-icon.png',
  manifest = '/creattia.webmanifest',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url).href;
const socialImageURL = new URL(ogImage, Astro.site || Astro.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Creattia',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://creattia.app',
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Tres generaciones gratis para probar la plataforma.',
  },
};

// El identificador del píxel, compartido con los envíos del servidor para que
// no puedan quedar apuntando a píxeles distintos.
import { META_PIXEL_ID } from '../lib/creattia/meta-pixel';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6d35e8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Creattia" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={favicon} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/creattia/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/creattia/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/creattia/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/creattia/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <meta name="msapplication-TileImage" content="/images/creattia/mstile-150x150.png" />
    <link rel="manifest" href={manifest} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    {/* Píxel de Meta. El identificador es público —viaja en el navegador de
        cualquiera que entre— así que va en el código; el token de la API de
        conversiones, que sí es secreto, vive solo en el servidor.

        Acá se manda únicamente PageView y lo que ocurre antes de tocar el
        servidor. El resto del embudo, incluido el pago, sale desde el servidor:
        el navegador no llega a reportar una compra que se confirma por webhook
        cuando la persona ya cerró la pestaña, y los bloqueadores se comen otra
        parte. */}
    <script is:inline define:vars={{ pixelId: META_PIXEL_ID }}>
      if (pixelId) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      }
    </script>
  </head>
  <body>
    <slot />

    {/* ── "Sitio para computadora": el aviso, en todas las páginas ─────────────
        Cuando el teléfono tiene activado ese modo, el navegador ignora a
        propósito el viewport y dibuja la página a ~980px de ancho para después
        achicarla hasta que entre. Todo queda diminuto, las grillas salen en
        varias columnas —los planes, por ejemplo, en dos columnas en vez de una
        debajo de la otra— y hay que arrastrar la pantalla de costado. Se ve
        exactamente como una app rota, pero no hay nada roto: es una preferencia
        de quien navega y desde el código NO se puede desactivar.

        Lo que sí se puede es reconocerlo y decirlo. `screen.width` informa el
        ancho real del aparato aunque el viewport mienta: pantalla física de
        teléfono + viewport de escritorio solo puede ser esto.

        Antes este aviso vivía solo dentro de la app y encima ya logueado, así
        que en la landing —donde la mayoría entra por primera vez— no aparecía
        nunca. Y se descartaba para SIEMPRE: quien lo cerró una vez sin
        entenderlo se quedó con la app ilegible y sin forma de volver a leer
        cómo arreglarlo. Ahora se descarta por sesión. */}
    <div id="aviso-escritorio" role="status" hidden>
      <div>
        <strong>Estás viendo la versión de computadora</strong>
        <span>
          Tu navegador tiene activado <b>“Sitio para computadora”</b> y por eso todo se ve
          chico. Desactivalo y la página se acomoda a tu pantalla: en Chrome está en el
          menú <b>⋮</b>, en Safari en <b>aA</b> → “Solicitar sitio para móviles”.
        </span>
      </div>
      <button type="button" id="aviso-escritorio-cerrar" aria-label="Entendido">Entendido</button>
    </div>

    <script is:inline>
      (function () {
        var aviso = document.getElementById('aviso-escritorio');
        var cerrar = document.getElementById('aviso-escritorio-cerrar');
        if (!aviso || !cerrar) return;
        var oculto = false;
        try { oculto = sessionStorage.getItem('creattia-aviso-escritorio') === 'visto'; } catch (e) { /* sin storage */ }

        function revisar() {
          if (oculto) { aviso.hidden = true; return; }
          var fisica = Math.min(screen.width || 0, screen.height || 0);
          var esTelefono = fisica > 0 && fisica <= 500;
          var viewportDeEscritorio = window.innerWidth >= 900;
          aviso.hidden = !(esTelefono && viewportDeEscritorio);
        }

        cerrar.addEventListener('click', function () {
          oculto = true;
          try { sessionStorage.setItem('creattia-aviso-escritorio', 'visto'); } catch (e) { /* sin storage */ }
          aviso.hidden = true;
        });
        window.addEventListener('resize', revisar);
        window.addEventListener('orientationchange', revisar);
        revisar();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  *, *::before, *::after { box-sizing: border-box; }
  html { font-family: 'Inter Variable', Inter, system-ui, sans-serif; background: #fff; }
  body { min-width: 320px; margin: 0; }
  button, input, textarea, select { font: inherit; }

  /* El aviso de "sitio para computadora". Va abajo y flotando para no tapar
     nada de la página, y con letra grande porque en ese modo todo se ve chico:
     si el aviso que explica el problema también fuera diminuto, no serviría. */
  #aviso-escritorio {
    position: fixed;
    z-index: 9000;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    border-radius: 16px;
    background: #19171d;
    color: #fff;
    box-shadow: 0 20px 50px rgba(12, 8, 18, .38);
    font-size: 17px;
    line-height: 1.45;
  }
  #aviso-escritorio[hidden] { display: none; }
  #aviso-escritorio > div { display: flex; flex-direction: column; gap: 6px; }
  #aviso-escritorio strong { font-size: 19px; font-weight: 800; }
  #aviso-escritorio span { color: #cfc9d6; }
  #aviso-escritorio b { color: #fff; font-weight: 750; }
  #aviso-escritorio button {
    flex: 0 0 auto;
    min-height: 46px;
    padding: 0 22px;
    border: 0;
    border-radius: 11px;
    background: #fff;
    color: #19171d;
    font-family: inherit;
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
  }
</style>
